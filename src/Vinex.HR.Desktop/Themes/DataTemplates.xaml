<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Vinex.HR.Desktop.ViewModels"
                    xmlns:views="clr-namespace:Vinex.HR.Desktop.Views">
    <!-- ViewModel-first navigation: each view model is rendered by its view. -->
    <DataTemplate DataType="{x:Type vm:LoginViewModel}"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}"><views:ChangePasswordView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ShellViewModel}"><views:ShellView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}"><views:ComingSoonView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:UserEditorViewModel}"><views:UserEditorView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResetPasswordViewModel}"><views:ResetPasswordView /></DataTemplate>
</ResourceDictionary>
