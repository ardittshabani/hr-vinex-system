<UserControl x:Class="Vinex.HR.Desktop.Views.LoginView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:Vinex.HR.Desktop.Behaviors">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource Card}" Width="400" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="V" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Vinex HR" Style="{StaticResource PageTitle}" Margin="0,16,0,0" />
                <TextBlock Text="Sign in to continue" Style="{StaticResource Muted}" />

                <TextBlock Text="{Binding Notice}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                           Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,20,0,4" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=UsernameBox, FallbackValue=''}" />

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput"
                             b:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ErrorText}"
                           Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PasswordInput, FallbackValue=''}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                           Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}" />

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"
                        IsDefault="True" IsEnabled="{Binding IsNotBusy}" Margin="0,24,0,0" Padding="16,10" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
