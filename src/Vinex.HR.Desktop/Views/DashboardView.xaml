<UserControl x:Class="Vinex.HR.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:Vinex.HR.Desktop.Behaviors">
    <StackPanel>
        <TextBlock Text="{Binding Greeting}" Style="{StaticResource SectionTitle}" FontSize="20" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,20" />
        <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="Total employees" Style="{StaticResource Muted}" /><TextBlock Text="-" FontSize="30" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="Present today" Style="{StaticResource Muted}" /><TextBlock Text="-" FontSize="30" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="Absent today" Style="{StaticResource Muted}" /><TextBlock Text="-" FontSize="30" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="On leave" Style="{StaticResource Muted}" /><TextBlock Text="-" FontSize="30" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
