<UserControl x:Class="Vinex.HR.Desktop.Views.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:b="clr-namespace:Vinex.HR.Desktop.Behaviors">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Style="{StaticResource Card}" Width="420" Margin="16" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,20,0,4" />
                <PasswordBox x:Name="CurrentBox" b:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CurrentBox, FallbackValue=''}" />

                <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="NewBox" b:PasswordBoxHelper.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=NewBox, FallbackValue=''}" />

                <TextBlock Text="CONFIRM NEW PASSWORD" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmBox" b:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ConfirmBox, FallbackValue=''}" />

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,12,0,0"
                           Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                    <Button Content="Save password" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                            IsDefault="True" IsEnabled="{Binding IsNotBusy}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
